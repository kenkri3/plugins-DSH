{
  "name": "dsh-plugin-google-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lagrer DeepSeek Harness-prosjekter (prosjektfiler som zip og samtalene som markdown) til Google Disk via Drive API.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "logic.js",
    "zip.js",
    "unzip.js",
    "transcript.js",
    "save.js",
    "verify.js",
    "oauth.js",
    "drive.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test"
  }
}
